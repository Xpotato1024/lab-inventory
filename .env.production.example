# Copy to .env on the workstation and replace every example value before first startup.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0

# Use the long-lived production hostname. Do not put a URL/path in ALLOWED_HOSTS.
DJANGO_ALLOWED_HOSTS=inventory.lab.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://inventory.lab.example

# Paths inside the container. Normally leave these unchanged.
LAB_INVENTORY_DB=/data/db.sqlite3
LAB_INVENTORY_BACKUP_DIR=/backups
LAB_INVENTORY_PORT=8000

# Persistent host paths kept outside the Git checkout.
LAB_INVENTORY_HOST_DATA_DIR=/srv/lab-inventory/data
LAB_INVENTORY_HOST_BACKUP_DIR=/srv/lab-inventory/backups

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
